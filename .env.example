APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Zoho CRM integration ---
# From api-console.zoho.com -> Server-based Application.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# One-time OAuth authorization-code exchange gives you this; it does not expire.
ZOHO_REFRESH_TOKEN=
# Data-center-specific. India: accounts.zoho.in, US: accounts.zoho.com,
# Europe: accounts.zoho.eu, Australia: accounts.zoho.com.au.
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
# Zoho's standard Purchase Orders module — confirmed against the client's
# real org, only override if theirs differs.
ZOHO_PO_MODULE_API_NAME=Purchase_Orders
ZOHO_FIELD_PO=PO_Number
ZOHO_FIELD_VENDOR_NAME=Vendor_Name
ZOHO_FIELD_SUBJECT=Subject
ZOHO_FIELD_PRODUCT_DETAILS=Purchase_Items
ZOHO_WEBHOOK_SECRET=
ZOHO_SYNC_MINUTES=30
ZOHO_WRITE_ENABLED=true
ZOHO_CREATE_ENABLED=false
ZOHO_WRITE_VENDOR_NAME=true
ZOHO_WRITE_PRODUCT_DETAILS=true

# --- Zoho Inventory integration (operational: Items/Vendors/POs/Bills/Purchase Receives) ---
# Ask the client for these — see SETUP_FOR_RECIPIENT.md. Leave blank and the
# Inventory sync stays inactive; CRM keeps handling this data until both are set.
# From the Zoho Inventory URL/API — looks like a numeric org ID.
ZOHO_INVENTORY_ORGANIZATION_ID=
# Needs a NEW OAuth authorization with Inventory scope (e.g.
# ZohoInventory.FullAccess.all) — the CRM refresh token above will not work
# here even though it's the same vendor/account.
ZOHO_INVENTORY_REFRESH_TOKEN=
# Only set these if the client registers a separate OAuth client for
# Inventory; otherwise it reuses ZOHO_CLIENT_ID / ZOHO_CLIENT_SECRET above.
ZOHO_INVENTORY_CLIENT_ID=
ZOHO_INVENTORY_CLIENT_SECRET=
# Data-center-specific, same DC as the CRM account. India: zohoapis.in,
# US: zohoapis.com, Europe: zohoapis.eu, Australia: zohoapis.com.au.
ZOHO_INVENTORY_API_BASE_URL=https://www.zohoapis.in/inventory/v1
ZOHO_INVENTORY_WRITE_ENABLED=true

# Master kill switch — set false to make every Zoho Inventory call a no-op
# without removing credentials. Fastest way to stop a runaway quota drain.
ZOHO_INVENTORY_SYNC_ENABLED=true

# --- Zoho Inventory rate limiting / quota budget ---
# Zoho enforces both a short-window rate and a per-day cap, and BOTH surface as
# error code 45. Confirm the real numbers on the org's Zoho subscription page;
# these defaults are deliberately conservative.
# Per-minute ceiling (smoothed with GCRA so calls are paced, not bursted).
ZOHO_INVENTORY_CALLS_PER_MINUTE=60
ZOHO_INVENTORY_CALL_BURST=10
# Working daily budget — keep below the real plan cap to leave headroom for
# webhooks, manual retries and OAuth token refreshes.
ZOHO_INVENTORY_CALLS_PER_DAY=800
# Must match the timezone Zoho resets the daily counter in.
ZOHO_INVENTORY_QUOTA_TIMEZONE=Asia/Kolkata
# Ceiling for a single cron run, so one run cannot drain the whole day.
ZOHO_INVENTORY_CALLS_PER_RUN=120
# Circuit breaker cooldown ladder in minutes — each successive trip escalates.
ZOHO_INVENTORY_BREAKER_LADDER=30,60,180,360
ZOHO_INVENTORY_RATE_LIMIT_COOLDOWN_MINUTES=180
# Permanent failures a single record may accumulate before it is quarantined and
# the checkpoint advances past it (stops one bad row pinning the whole backlog).
ZOHO_INVENTORY_MAX_RECORD_FAILURES=3
# Delay on queued pushes so a PO plus its line saves collapse into one push.
ZOHO_INVENTORY_COALESCE_SECONDS=30
ZOHO_INVENTORY_HTTP_TIMEOUT=15
ZOHO_INVENTORY_HTTP_CONNECT_TIMEOUT=5
